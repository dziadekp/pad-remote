<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/bg_widget">

    <!-- header: status pill + target -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:id="@+id/w_info" android:layout_width="wrap_content" android:layout_height="28dp"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:background="@drawable/bg_pill">
            <TextView android:id="@+id/w_dot" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="●" android:textColor="@color/muted" android:textSize="10sp" />
            <TextView android:id="@+id/w_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:text="Walking pad" android:textColor="@color/text" android:textSize="13sp" android:maxLines="1" />
        </LinearLayout>
        <TextView android:id="@+id/w_target" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:text="" android:textColor="@color/muted" android:textSize="13sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
        <!-- Stop sits up here, away from +/- so it isn't hit by accident -->
        <Button android:id="@+id/w_stop" android:layout_width="96dp" android:layout_height="44dp"
            android:text="Stop" android:textAllCaps="false" android:textSize="16sp" android:textStyle="bold"
            android:textColor="@color/text" android:background="@drawable/bg_stop" />
    </LinearLayout>

    <!-- hero speed, fills spare height -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center">
        <TextView android:id="@+id/w_speed" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="0.0" android:textColor="@color/text" android:textSize="64sp" android:textStyle="bold"
            android:includeFontPadding="false" android:fontFeatureSettings="tnum" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
            android:text="mph" android:textColor="@color/muted" android:textSize="16sp" />
    </LinearLayout>

    <!-- four stat tiles -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center" android:paddingVertical="8dp" android:background="@drawable/bg_tile">
            <TextView android:id="@+id/w_dist" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0" android:textColor="@color/text" android:textSize="17sp" android:textStyle="bold" android:fontFeatureSettings="tnum" android:maxLines="1" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MILES"
                android:textColor="@color/muted" android:textSize="10sp" android:letterSpacing="0.1" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp"
            android:orientation="vertical" android:gravity="center" android:paddingVertical="8dp" android:background="@drawable/bg_tile">
            <TextView android:id="@+id/w_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0" android:textColor="@color/text" android:textSize="17sp" android:textStyle="bold" android:fontFeatureSettings="tnum" android:maxLines="1" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TIME"
                android:textColor="@color/muted" android:textSize="10sp" android:letterSpacing="0.1" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp"
            android:orientation="vertical" android:gravity="center" android:paddingVertical="8dp" android:background="@drawable/bg_tile">
            <TextView android:id="@+id/w_steps" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0" android:textColor="@color/text" android:textSize="17sp" android:textStyle="bold" android:fontFeatureSettings="tnum" android:maxLines="1" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="STEPS"
                android:textColor="@color/muted" android:textSize="10sp" android:letterSpacing="0.1" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp"
            android:orientation="vertical" android:gravity="center" android:paddingVertical="8dp" android:background="@drawable/bg_tile">
            <TextView android:id="@+id/w_cal" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0" android:textColor="@color/text" android:textSize="17sp" android:textStyle="bold" android:fontFeatureSettings="tnum" android:maxLines="1" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="KCAL"
                android:textColor="@color/muted" android:textSize="10sp" android:letterSpacing="0.1" />
        </LinearLayout>
    </LinearLayout>

    <!-- controls -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:orientation="horizontal">
        <Button android:id="@+id/w_down" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="−" android:textSize="26sp" android:textColor="@color/text" android:background="@drawable/bg_tile" />
        <Button android:id="@+id/w_start" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.6"
            android:layout_marginStart="8dp" android:text="Start" android:textAllCaps="false" android:textSize="16sp" android:textStyle="bold"
            android:textColor="@color/text" android:background="@drawable/bg_go" />
        <Button android:id="@+id/w_up" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="8dp" android:text="+" android:textSize="26sp" android:textColor="@color/text" android:background="@drawable/bg_tile" />
    </LinearLayout>
</LinearLayout>
