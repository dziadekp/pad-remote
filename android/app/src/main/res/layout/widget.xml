<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp" android:background="@drawable/bg_widget">

    <LinearLayout android:id="@+id/w_info" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_speed" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="–" android:textColor="@color/text" android:textSize="34sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp"
            android:text="mph" android:textColor="@color/muted" android:textSize="13sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="end">
            <TextView android:id="@+id/w_dist" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="– mi" android:textColor="@color/text" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="–:––" android:textColor="@color/text" android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/w_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Not connected · tap Start" android:textColor="@color/muted" android:textSize="12sp"
        android:maxLines="1" android:ellipsize="end" android:layout_marginBottom="6dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal">
        <Button android:id="@+id/w_down" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="−" android:textSize="24sp" android:textColor="@color/text" android:background="@drawable/bg_btn" />
        <Button android:id="@+id/w_start" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.4"
            android:layout_marginStart="6dp" android:text="Start" android:textSize="16sp" android:textStyle="bold"
            android:textColor="@color/text" android:background="@drawable/bg_go" />
        <Button android:id="@+id/w_stop" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.6"
            android:layout_marginStart="6dp" android:text="STOP" android:textSize="18sp" android:textStyle="bold"
            android:textColor="@color/text" android:background="@drawable/bg_stop" />
        <Button android:id="@+id/w_up" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="6dp" android:text="+" android:textSize="24sp" android:textColor="@color/text" android:background="@drawable/bg_btn" />
    </LinearLayout>
</LinearLayout>
