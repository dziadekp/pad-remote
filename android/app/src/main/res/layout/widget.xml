<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingHorizontal="14dp" android:paddingVertical="10dp" android:background="@drawable/bg_widget">

    <LinearLayout android:id="@+id/w_info" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/w_dot" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="●" android:textColor="@color/muted" android:textSize="9sp" />
                <TextView android:id="@+id/w_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="5dp" android:text="Walking pad" android:textColor="@color/muted" android:textSize="12sp" android:maxLines="1" />
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
                <TextView android:id="@+id/w_speed" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0.0" android:textColor="@color/text" android:textSize="40sp" android:textStyle="bold"
                    android:includeFontPadding="false" android:fontFeatureSettings="tnum" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp"
                    android:layout_marginBottom="4dp" android:text="mph" android:textColor="@color/muted" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"
            android:gravity="center" android:paddingHorizontal="12dp" android:paddingVertical="6dp" android:background="@drawable/bg_tile">
            <TextView android:id="@+id/w_dist" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0.00" android:textColor="@color/text" android:textSize="17sp" android:textStyle="bold" android:fontFeatureSettings="tnum" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MILES"
                android:textColor="@color/muted" android:textSize="9sp" android:letterSpacing="0.1" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:orientation="vertical"
            android:gravity="center" android:paddingHorizontal="12dp" android:paddingVertical="6dp" android:background="@drawable/bg_tile">
            <TextView android:id="@+id/w_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0:00" android:textColor="@color/text" android:textSize="17sp" android:textStyle="bold" android:fontFeatureSettings="tnum" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TIME"
                android:textColor="@color/muted" android:textSize="9sp" android:letterSpacing="0.1" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:orientation="horizontal">
        <Button android:id="@+id/w_down" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="−" android:textSize="24sp" android:textColor="@color/text" android:background="@drawable/bg_tile" />
        <Button android:id="@+id/w_start" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.6"
            android:layout_marginStart="6dp" android:text="Start" android:textAllCaps="false" android:textSize="15sp" android:textStyle="bold"
            android:textColor="@color/text" android:background="@drawable/bg_go" />
        <Button android:id="@+id/w_stop" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.6"
            android:layout_marginStart="6dp" android:text="Stop" android:textAllCaps="false" android:textSize="15sp" android:textStyle="bold"
            android:textColor="@color/text" android:background="@drawable/bg_stop" />
        <Button android:id="@+id/w_up" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="6dp" android:text="+" android:textSize="24sp" android:textColor="@color/text" android:background="@drawable/bg_tile" />
    </LinearLayout>
</LinearLayout>
