<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingHorizontal="14dp" android:paddingVertical="12dp" android:background="@drawable/bg_widget">

    <LinearLayout android:id="@+id/w_info" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="vertical" android:gravity="center_vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/w_dot" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="●" android:textColor="@color/muted" android:textSize="11sp" />
            <TextView android:id="@+id/w_status" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="6dp" android:text="Walking pad" android:textColor="@color/muted" android:textSize="13sp"
                android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_target" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="@color/muted" android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp"
            android:orientation="horizontal" android:gravity="bottom">
            <TextView android:id="@+id/w_speed" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0.0" android:textColor="@color/text" android:textSize="46sp" android:textStyle="bold"
                android:includeFontPadding="false" android:fontFeatureSettings="tnum" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp"
                android:layout_marginBottom="6dp" android:text="mph" android:textColor="@color/muted" android:textSize="14sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:gravity="end">
                <TextView android:id="@+id/w_dist" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0.00 mi" android:textColor="@color/text" android:textSize="20sp" android:textStyle="bold" android:fontFeatureSettings="tnum" />
                <TextView android:id="@+id/w_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0:00" android:textColor="@color/text" android:textSize="16sp" android:fontFeatureSettings="tnum" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:id="@+id/w_extra" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:gravity="end" android:text="" android:textColor="@color/muted" android:textSize="13sp" android:maxLines="1" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:orientation="horizontal">
        <Button android:id="@+id/w_down" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="−" android:textSize="26sp" android:textColor="@color/text" android:background="@drawable/bg_btn" />
        <Button android:id="@+id/w_start" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.5"
            android:layout_marginStart="6dp" android:text="Start" android:textAllCaps="false" android:textSize="16sp" android:textStyle="bold"
            android:textColor="@color/text" android:background="@drawable/bg_go" />
        <Button android:id="@+id/w_stop" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.5"
            android:layout_marginStart="6dp" android:text="STOP" android:textSize="16sp" android:textStyle="bold"
            android:textColor="@color/text" android:background="@drawable/bg_stop" />
        <Button android:id="@+id/w_up" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="6dp" android:text="+" android:textSize="26sp" android:textColor="@color/text" android:background="@drawable/bg_btn" />
    </LinearLayout>
</LinearLayout>
